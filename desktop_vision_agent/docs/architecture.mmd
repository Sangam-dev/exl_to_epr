    class AgentConfig {
        +AppConfig app
        +ExcelConfig excel
        +FieldConfig[] fields
        +ActionsConfig actions
        +GeminiConfig gemini
        +SafetyConfig safety
    }

    class AppConfig {
        +str title_contains
        +str process_name
        +bool require_foreground
        +bool pin_window
    }

    class ExcelConfig {
        +str input_path
        +str output_path
        +any sheet
        +int header_row
        +str id_column
        +str status_column
        +str timestamp_column
        +str error_column
        +str done_value
        +str recheck_value
        +str[] skip_statuses
        +str empty_cell_policy
        +str[] required_columns
    }

    class FieldConfig {
        +str column
        +str field
        +str type
    }

    class ActionsConfig {
        +str save_button
        +str new_record_button
        +float wait_after_save_seconds
    }

    class GeminiConfig {
        +str model
        +int max_image_dimension
        +int timeout_seconds
        +int max_retries
        +int max_ai_calls
        +float min_layout_confidence
        +float min_mapping_confidence

# Copy this file to .env in the same folder, then fill in your own key.
# .env is gitignored - never commit it or paste a key into a config file.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# LOG_LEVEL=INFO
# LOG_CONSOLE=1
